table anomaly_analysis
	lineageTag: e1d03d62-950b-46ff-b215-fc1b8bc80280

	measure 'Delivery Success Rate' =
			
			DIVIDE(
			    SUM(monthly_performance[delivered]),
			    SUM(monthly_performance[orders]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ce005f9b-ccc4-4c06-a80c-295e3bd03b4f

	measure 'On-Time Delivery %' =
			
			DIVIDE(
			    SUM(monthly_performance[on_time]),
			    SUM(monthly_performance[eligible])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3682ccea-31a1-46c3-ab32-32b824d0c03e

	measure 'Flagged Anomaly Days' =
			CALCULATE(
			    COUNTROWS(anomaly_analysis),
			    anomaly_analysis[anomaly] = TRUE()
			)
		formatString: #,0
		lineageTag: de44888f-a84c-4ebb-ba6e-c5457b391f1d

	column day
		dataType: dateTime
		formatString: Long Date
		lineageTag: 7ab0ff9f-47a7-48a6-9305-bcd87fc6a143
		summarizeBy: none
		sourceColumn: day

		variation Variation
			isDefault
			relationship: d85f5a56-4c70-493e-b1d9-5d42bce05d18
			defaultHierarchy: LocalDateTable_e01c7304-3db8-4de4-8f0a-81cd33b2c542.'Date Hierarchy'

